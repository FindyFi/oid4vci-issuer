PORT=4007

# This service's own public base URL - used in issuer metadata and as the
# expected `aud` of the wallet's proof-of-possession JWT. Must be a real
# HTTPS hostname for wallet interop (localhost won't work: wallets can't
# resolve .well-known discovery or deep links against it).
CREDENTIAL_ISSUER=https://example.org

# Map of credential_configuration_id -> OID4VCI credential configuration
# object, as JSON. This is the one piece of domain content this service
# needs, since it's issuer metadata, not per-request data. proof_types_supported
# is what makes OID4VCI 1.0 require a proof (and therefore the Nonce
# Endpoint) for this credential type - this service always requires one, so
# every configuration here should declare it.
# Supported formats: vc+sd-jwt (signed by this service, needs
# SD_JWT_SIGNING_KEY) and ldp_vc (signed by signing-service, needs
# SIGNING_SERVICE_*). Any other format stops the service at startup.
CREDENTIAL_CONFIGURATIONS_SUPPORTED={"OpenBadgeCredentialSdJwt":{"format":"vc+sd-jwt","credential_definition":{"@context":["https://www.w3.org/ns/credentials/v2","https://purl.imsglobal.org/spec/ob/v3p0/context-3.0.3.json"],"type":["VerifiableCredential","OpenBadgeCredential"]},"credential_signing_alg_values_supported":["ES256"],"proof_types_supported":{"jwt":{"proof_signing_alg_values_supported":["ES256"]}}},"OpenBadgeCredential":{"format":"ldp_vc","credential_definition":{"@context":["https://www.w3.org/2018/credentials/v1","https://purl.imsglobal.org/spec/ob/v3p0/context-3.0.3.json"],"type":["VerifiableCredential","OpenBadgeCredential"]},"proof_types_supported":{"jwt":{"proof_signing_alg_values_supported":["ES256"]}}}}

# This service's own key for signing vc+sd-jwt credentials: a private EC
# P-256 JWK as JSON (see the README for a one-liner that makes one), or
# "generate" for local dev only (a fresh key on every start, so credentials
# issued before a restart stop verifying). The public key is published at
# /.well-known/jwt-vc-issuer.
SD_JWT_SIGNING_KEY=generate

# The SD-JWT `iss`, and the issuer id coordinators must put in the
# credential. Optional, defaults to CREDENTIAL_ISSUER. Origin only: no path,
# no trailing slash.
# SD_JWT_ISSUER=https://example.org

# A https://github.com/digitalcredentials/signing-service instance, used
# only for ldp_vc configurations: called when a wallet completes the flow
# and the stored unsigned credential needs to actually be signed.
SIGNING_SERVICE_URL=http://localhost:4006
SIGNING_SERVICE_INSTANCE=test
SIGNING_SERVICE_SUITE=ed25519

# Shared secret required (as a Bearer token) on POST /instance/:tenant/offers,
# the coordinator-facing endpoint. Leave unset only for local dev - anyone
# who can reach that endpoint without it can get arbitrary content signed by
# your keys.
COORDINATOR_TOKEN=change-me
