# @env optional
PORT=4007

# This service's own public base URL - used in issuer metadata and as the
# expected `aud` of the wallet's proof-of-possession JWT. Must be a real
# HTTPS hostname for wallet interop (localhost won't work: wallets can't
# resolve .well-known discovery or deep links against it).
# @env required
CREDENTIAL_ISSUER=https://example.org

# Map of credential_configuration_id -> OID4VCI credential configuration
# object, as JSON. This is the one piece of domain content this service
# needs, since it's issuer metadata, not per-request data. proof_types_supported
# is what makes OID4VCI 1.0 require a proof (and therefore the Nonce
# Endpoint) for this credential type - this service always requires one, so
# every configuration here should declare it.
# Supported formats: dc+sd-jwt and vc+sd-jwt (signed by this service, needs
# SD_JWT_SIGNING_KEY) and ldp_vc (signed by signing-service, needs
# SIGNING_SERVICE_*). Any other format stops the service at startup.
# @env required
CREDENTIAL_CONFIGURATIONS_SUPPORTED={"OpenBadgeCredentialSdJwtVc":{"format":"dc+sd-jwt","vct":"https://example.org/vct/OpenBadgeCredential","cryptographic_binding_methods_supported":["jwk"],"credential_signing_alg_values_supported":["ES256"],"proof_types_supported":{"jwt":{"proof_signing_alg_values_supported":["ES256"]}},"credential_metadata":{"display":[{"name":"Opintotodiste","locale":"fi","description":"Open Badge Koski-opintotiedoista"},{"name":"Study credential","locale":"en","description":"Open Badge from Koski study records"}],"claims":[{"path":["achievement","name"],"display":[{"name":"Tutkinto tai suoritus","locale":"fi"},{"name":"Qualification","locale":"en"}]},{"path":["achievement","fieldOfStudy"],"display":[{"name":"Koulutusala","locale":"fi"},{"name":"Field of study","locale":"en"}]},{"path":["achievement","creator","name"],"display":[{"name":"Oppilaitos","locale":"fi"},{"name":"Institution","locale":"en"}]},{"path":["achievement","description"],"display":[{"name":"Kuvaus","locale":"fi"},{"name":"Description","locale":"en"}]},{"path":["awarded_on"],"display":[{"name":"Myönnetty","locale":"fi"},{"name":"Awarded on","locale":"en"}]}]}},"OpenBadgeCredentialSdJwt":{"format":"vc+sd-jwt","credential_definition":{"@context":["https://www.w3.org/ns/credentials/v2","https://purl.imsglobal.org/spec/ob/v3p0/context-3.0.3.json"],"type":["VerifiableCredential","OpenBadgeCredential"]},"credential_signing_alg_values_supported":["ES256"],"proof_types_supported":{"jwt":{"proof_signing_alg_values_supported":["ES256"]}},"cryptographic_binding_methods_supported":["jwk"]},"OpenBadgeCredential":{"format":"ldp_vc","credential_definition":{"@context":["https://www.w3.org/2018/credentials/v1","https://purl.imsglobal.org/spec/ob/v3p0/context-3.0.3.json"],"type":["VerifiableCredential","OpenBadgeCredential"]},"proof_types_supported":{"jwt":{"proof_signing_alg_values_supported":["ES256"]}}}}

# This service's own key for signing dc+sd-jwt and vc+sd-jwt credentials:
# "kms:<key ARN>" for an AWS KMS key (production; see "Production keys" in
# the README), a private EC P-256 JWK as JSON (see the README for a one-liner
# that makes one), or "generate" for local dev only (a fresh key on every
# start, so credentials issued before a restart stop verifying). The public
# key is published at /.well-known/jwt-vc-issuer. Not tagged secret because
# the deployed "kms:<ARN>" form isn't sensitive; a JWK value is, so it must
# come from a secret store.
# @env required
SD_JWT_SIGNING_KEY=generate

# After a key rotation: the earlier keys' public JWKs, as a JSON array. They
# stay in /.well-known/jwt-vc-issuer so older credentials keep verifying.
# @env optional
# SD_JWT_PREVIOUS_KEYS=[{"kty":"EC","crv":"P-256","x":"...","y":"..."}]

# Optional X.509 chain for the signing key (PEM, leaf first), sent as x5c in
# SD-JWT headers for wallets that only trust certificates. "generate" makes a
# self-signed certificate on every start (dev only); for a stored one, run
# scripts/self-signed-x5c.js.
# @env optional
# SD_JWT_X5C=generate

# The SD-JWT `iss`, and the issuer id coordinators must put in the
# credential. Optional, defaults to CREDENTIAL_ISSUER. Origin only: no path,
# no trailing slash.
# @env optional
# SD_JWT_ISSUER=https://example.org

# A https://github.com/digitalcredentials/signing-service instance, used
# only for ldp_vc configurations: called when a wallet completes the flow
# and the stored unsigned credential needs to actually be signed. Optional
# because an issuer with no ldp_vc configuration doesn't need it, and the
# service already refuses to start if one is configured without
# SIGNING_SERVICE_URL. Set all three wherever ldp_vc is offered.
# @env optional
SIGNING_SERVICE_URL=http://localhost:4006
# @env optional
SIGNING_SERVICE_INSTANCE=test
# @env optional
SIGNING_SERVICE_SUITE=ed25519

# Shared secret required (as a Bearer token) on POST /instance/:tenant/offers,
# the coordinator-facing endpoint. Leave unset only for local dev - anyone
# who can reach that endpoint without it can get arbitrary content signed by
# your keys.
# @env required secret
COORDINATOR_TOKEN=change-me

# OpenID Federation Entity Configuration (DIIP v5, OpenID Federation wallet
# architectures), served at /.well-known/openid-federation. Federation is on
# when this is set: a JSON object whose `display_name` is required; other
# members (organization_name, contacts, homepage_uri, logo_uri, policy_uri,
# ...) are passed through. It needs SD_JWT_SIGNING_KEY, and SD_JWT_ISSUER (if
# set) must equal CREDENTIAL_ISSUER. Don't write the JSON by hand: run
# `npm run federation:setup` (see the README).
# @env optional
# FEDERATION_ENTITY_METADATA={"display_name":"Example University","organization_name":"Example University Oy","contacts":["it@example.org"],"homepage_uri":"https://example.org"}

# The entity IDs of the trust anchor or intermediates above this issuer, as a
# JSON array of https URLs. Only once you have joined a federation.
# @env optional
# FEDERATION_AUTHORITY_HINTS=["https://trust-anchor.example"]

# Trust marks issued to this entity, as a JSON array, published as-is.
# @env optional
# FEDERATION_TRUST_MARKS=[]

# Seconds the Entity Configuration is valid (its exp). Default 86400.
# @env optional
# FEDERATION_ENTITY_CONFIGURATION_TTL=86400

# "1" logs one line per request (body shape, error returned, user agent),
# for wallet interop debugging.
# @env optional
# LOG_REQUESTS=1
